+        // Compare against what the pair drew, not the union of scissor states: a full-screen scissor set for a
+        // small overlay (e.g. blinking text) must not change the layout of the scene under it between frames.
+        const FixedRect &drawnRect = drawColorRect.isEmpty() ? scissorRect : drawColorRect;
+        return !projectionRect.isEmpty() && (projectionRect.ulx <= drawnRect.ulx) && (projectionRect.lrx >= drawnRect.lrx);
