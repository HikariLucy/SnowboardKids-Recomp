+bool renderer::RT64Context::export_semantic_state(std::vector<uint8_t>& out_blob) {
+    if (!app || !app->state || !app->state->rdp) return false;
+
+    sbk::quiescence::SemanticStateHeader header{};
+    header.magic = sbk::quiescence::SEMANTIC_STATE_MAGIC;
+    header.version = sbk::quiescence::SEMANTIC_STATE_VERSION;
+    header.generation = sbk::quiescence::status().generation;
+
+    auto* rdp = app->state->rdp.get();
+    std::memcpy(header.rdp.tmem, rdp->TMEM, 4096);
+    for (int i = 0; i < 8; ++i) {
+        header.rdp.tiles[i].fmt = rdp->tiles[i].fmt;
+        header.rdp.tiles[i].siz = rdp->tiles[i].siz;
+        header.rdp.tiles[i].line = rdp->tiles[i].line;
+        header.rdp.tiles[i].tmem = rdp->tiles[i].tmem;
+        header.rdp.tiles[i].palette = rdp->tiles[i].palette;
+        header.rdp.tiles[i].cmt = rdp->tiles[i].cmt;
+        header.rdp.tiles[i].cms = rdp->tiles[i].cms;
+        header.rdp.tiles[i].maskt = rdp->tiles[i].maskt;
+        header.rdp.tiles[i].masks = rdp->tiles[i].masks;
+        header.rdp.tiles[i].shiftt = rdp->tiles[i].shiftt;
+        header.rdp.tiles[i].shifts = rdp->tiles[i].shifts;
+        header.rdp.tiles[i].uls = rdp->tiles[i].uls;
+        header.rdp.tiles[i].ult = rdp->tiles[i].ult;
+        header.rdp.tiles[i].lrs = rdp->tiles[i].lrs;
+        header.rdp.tiles[i].lrt = rdp->tiles[i].lrt;
+        header.rdp.tiles[i].replacement_hash = rdp->tileReplacementHashes[i];
+    }
+    header.rdp.texture_fmt = rdp->texture.fmt;
+    header.rdp.texture_siz = rdp->texture.siz;
+    header.rdp.texture_width = rdp->texture.width;
+    header.rdp.texture_address = rdp->texture.address;
+
+    header.rdp.color_image_address = rdp->colorImage.address;
+    header.rdp.color_image_fmt = rdp->colorImage.fmt;
+    header.rdp.color_image_siz = rdp->colorImage.siz;
+    header.rdp.color_image_width = rdp->colorImage.width;
+
+    header.rdp.depth_image_address = rdp->depthImage.address;
+
+    header.rdp.other_mode_h = rdp->otherMode.H;
+    header.rdp.other_mode_l = rdp->otherMode.L;
+
+    header.rdp.combiner_cycle1 = rdp->colorCombinerStack[0].L;
+    header.rdp.combiner_cycle2 = rdp->colorCombinerStack[0].H;
+
+    std::memcpy(header.rdp.env_color, &rdp->envColorStack[0], sizeof(float) * 4);
+    std::memcpy(header.rdp.prim_color, &rdp->primColorStack[0], sizeof(float) * 4);
+    std::memcpy(header.rdp.prim_lod, &rdp->primLODStack[0], sizeof(float) * 2);
+    std::memcpy(header.rdp.prim_depth, &rdp->primDepthStack[0], sizeof(float) * 2);
+    std::memcpy(header.rdp.blend_color, &rdp->blendColorStack[0], sizeof(float) * 4);
+    std::memcpy(header.rdp.fog_color, &rdp->fogColorStack[0], sizeof(float) * 4);
+    header.rdp.fill_color = rdp->fillColorStack[0];
+
+    header.rdp.scissor_ulx = rdp->scissorRectStack[0].ulx;
+    header.rdp.scissor_uly = rdp->scissorRectStack[0].uly;
+    header.rdp.scissor_lrx = rdp->scissorRectStack[0].lrx;
+    header.rdp.scissor_lry = rdp->scissorRectStack[0].lry;
+    header.rdp.scissor_mode = rdp->scissorModeStack[0];
+
+    std::memcpy(header.rdp.convert_k, rdp->convertK, sizeof(int32_t) * 6);
+    std::memcpy(header.rdp.key_center, &rdp->keyCenter, sizeof(float) * 3);
+    std::memcpy(header.rdp.key_scale, &rdp->keyScale, sizeof(float) * 3);
+
+    const auto& vi = app->state->lastScreenVI;
+    header.vi.status = vi.status.word;
+    header.vi.origin = vi.origin;
+    header.vi.width = vi.width;
+    header.vi.v_intr = vi.intr;
+    header.vi.v_current = vi.vCurrentLine;
+    header.vi.burst = vi.burst.word;
+    header.vi.v_sync = vi.vSync;
+    header.vi.h_sync = vi.hSync.word;
+    header.vi.leap = vi.leap.word;
+    header.vi.h_sync_leap = 0;
+    header.vi.h_video = vi.hRegion.word;
+    header.vi.v_video = vi.vRegion.word;
+    header.vi.v_burst = vi.vBurst.word;
+    header.vi.x_scale = vi.xTransform.word;
+    header.vi.y_scale = vi.yTransform.word;
+
+    struct SerializedFb {
+        sbk::quiescence::SemanticFramebufferHeader hdr;
+        std::vector<uint8_t> pixels;
+    };
+    std::vector<SerializedFb> fbs;
+
+    uint32_t screen_addr = vi.fbAddress();
+    auto screen_size = vi.fbSize();
+    uint8_t screen_siz = vi.fbSiz();
+    if (screen_size.x > 0 && screen_size.y > 0 && screen_siz >= G_IM_SIZ_16b && screen_addr < 0x800000) {
+        uint32_t screen_bytes = (uint32_t(screen_size.x * screen_size.y) << (screen_siz - 1));
+        if (screen_addr + screen_bytes <= 0x800000) {
+            SerializedFb sfb{};
+            sfb.hdr.address = screen_addr;
+            sfb.hdr.width = screen_size.x;
+            sfb.hdr.height = screen_size.y;
+            sfb.hdr.siz = screen_siz;
+            sfb.hdr.fmt = G_IM_FMT_RGBA;
+            sfb.hdr.type = 1; // Color
+            sfb.hdr.pixel_bytes = screen_bytes;
+            std::vector<uint8_t> gpu_color;
+            if (readback_gpu_target(false, gpu_color, nullptr) && gpu_color.size() == screen_bytes) {
+                sfb.pixels = std::move(gpu_color);
+            } else {
+                sfb.pixels.resize(screen_bytes);
+                std::memcpy(sfb.pixels.data(), &app->core.RDRAM[screen_addr], screen_bytes);
+            }
+            fbs.push_back(std::move(sfb));
+        }
+    }
+
+    uint32_t depth_addr = rdp->depthImage.address;
+    if (depth_addr > 0 && depth_addr < 0x800000 && screen_size.x > 0 && screen_size.y > 0) {
+        uint32_t depth_bytes = screen_size.x * screen_size.y * 2;
+        if (depth_addr + depth_bytes <= 0x800000) {
+            SerializedFb dfb{};
+            dfb.hdr.address = depth_addr;
+            dfb.hdr.width = screen_size.x;
+            dfb.hdr.height = screen_size.y;
+            dfb.hdr.siz = G_IM_SIZ_16b;
+            dfb.hdr.fmt = G_IM_FMT_DEPTH;
+            dfb.hdr.type = 2; // Depth
+            dfb.hdr.pixel_bytes = depth_bytes;
+            std::vector<uint8_t> gpu_depth;
+            if (readback_gpu_target(true, gpu_depth, nullptr) && gpu_depth.size() == depth_bytes) {
+                dfb.pixels = std::move(gpu_depth);
+            } else {
+                dfb.pixels.resize(depth_bytes);
+                std::memcpy(dfb.pixels.data(), &app->core.RDRAM[depth_addr], depth_bytes);
+            }
+            fbs.push_back(std::move(dfb));
+        }
+    }
+
+    header.framebuffer_count = static_cast<uint32_t>(fbs.size());
+
+    out_blob.clear();
+    const uint8_t* hptr = reinterpret_cast<const uint8_t*>(&header);
+    out_blob.insert(out_blob.end(), hptr, hptr + sizeof(header));
+    for (const auto& fb : fbs) {
+        const uint8_t* fb_hdr_ptr = reinterpret_cast<const uint8_t*>(&fb.hdr);
+        out_blob.insert(out_blob.end(), fb_hdr_ptr, fb_hdr_ptr + sizeof(fb.hdr));
+        out_blob.insert(out_blob.end(), fb.pixels.begin(), fb.pixels.end());
+    }
+
+    sbk::quiescence::note("renderer-semantic", "export", out_blob.size());
+    return true;
+}
+
+bool renderer::RT64Context::reset_semantic_state() {
+    if (!app || !app->state) return false;
+
+    app->state->rdp->reset();
+    app->state->framebufferManager.destroyAllTileCopies();
+    app->sharedQueueResources->framebufferManager.destroyAllTileCopies();
+
+    if (app->state->renderFramebufferManager) {
+        app->state->renderFramebufferManager->destroyAll();
+    }
+
+    app->state->viHistory = RT64::VIHistory();
+    app->presentQueue->viHistory = RT64::VIHistory();
+    app->sharedQueueResources->interpolatedFrames[0] = {};
+    app->sharedQueueResources->interpolatedFrames[1] = {};
+    app->sharedQueueResources->interpolatedColorTargets.clear();
+    app->state->lastScreenFactorCounter = 0;
+
+    sbk::quiescence::note("renderer-semantic", "reset");
+    return true;
+}
