                 idleCondition.wait(idleLock, [&]() {
-                    return idleActive || !threadsRunning;
+                    return idleActive || quiescenceRequested || !threadsRunning;
                 });
+                if (quiescenceRequested) {
+                    idleQuiescent = true;
+                    idleCondition.notify_all();
+                    idleCondition.wait(idleLock, [&] { return !quiescenceRequested || !threadsRunning; });
+                    idleQuiescent = false;
+                }
+                if (!idleActive && threadsRunning) continue;
             }
 
