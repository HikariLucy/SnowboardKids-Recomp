+std::string PlayerCard::get_device_label_text() const {
+    using recompinput::DeviceLabelState;
+    switch (recompinput::profiles::get_assigned_input_device_for_player(player_index)) {
+        case recompinput::InputDevice::Keyboard:
+            return recompinput::device_label(DeviceLabelState::Keyboard);
+        case recompinput::InputDevice::Controller:
+            break;
+        default:
+            return recompinput::device_label(DeviceLabelState::NotAssigned);
+    }
+    if (recompinput::players::get_player_is_assigned(player_index)) {
+        SDL_GameController* controller = recompinput::players::get_player(player_index).controller;
+        if (controller == nullptr) {
+            return recompinput::device_label(DeviceLabelState::Keyboard);
+        }
+        if (!SDL_GameControllerGetAttached(controller)) {
+            return recompinput::device_label(DeviceLabelState::Disconnected);
+        }
+        return recompinput::device_label(DeviceLabelState::Controller, SDL_GameControllerName(controller));
+    }
+    // Single-player input reads every attached controller.
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (SDL_IsGameController(i)) {
+            return recompinput::device_label(DeviceLabelState::Controller, SDL_GameControllerNameForIndex(i));
+        }
+    }
+    return recompinput::device_label(DeviceLabelState::NoController);
+}
