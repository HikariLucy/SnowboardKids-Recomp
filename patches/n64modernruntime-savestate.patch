+ultramodern::savestate::UnsealResult ultramodern::savestate::unseal_external_inbox(bool admit) {
+    std::lock_guard lock(external_producer_mutex);
+    UnsealResult result{};
+    inbox_sealed = false;
+    for (const auto& entry : deferred_messages) {
+        if (admit) {
+            external_messages.enqueue(external_producer, entry);
+            sbk::quiescence::note("external-events", "deferred-admitted", entry.identity);
