+        return false;
+    }
+    for (const auto& record : state.loaded) {
+        if (record.section_table_index >= sections_info.num_code_sections) return false;
+    }
+    // Unload the current timeline's sections without touching guest memory.
+    for (const auto& loaded : loaded_sections) {
