+bool renderer::RT64Context::readback_gpu_target(bool depth, std::vector<uint8_t>& out_pixels, uint64_t* out_hash) {
+    if (!app || !app->state || !app->sharedQueueResources) return false;
+    if (app->workloadQueue) app->workloadQueue->waitForIdle();
+    if (app->presentQueue) app->presentQueue->waitForIdle();
+    const auto& vi = app->state->lastScreenVI;
+    auto fb_size = vi.fbSize();
+    uint8_t fb_siz = vi.fbSiz();
+    if (fb_size.x == 0 || fb_size.y == 0) return false;
+
+    uint32_t target_addr = 0;
+    uint8_t target_siz = fb_siz;
+    uint8_t target_fmt = G_IM_FMT_RGBA;
+    RT64::Framebuffer::Type fbType = RT64::Framebuffer::Type::Color;
+
+    if (!depth) {
+        target_addr = vi.fbAddress();
+        if (target_addr >= 0x800000 || target_siz < G_IM_SIZ_16b) return false;
+    } else {
+        target_addr = app->state->rdp ? app->state->rdp->depthImage.address : 0;
+        if (target_addr == 0 || target_addr >= 0x800000) return false;
+        target_siz = G_IM_SIZ_16b;
+        target_fmt = G_IM_FMT_DEPTH;
+        fbType = RT64::Framebuffer::Type::Depth;
+    }
+
+    uint32_t byte_count = (uint32_t(fb_size.x * fb_size.y) << (target_siz - 1));
+    if (target_addr + byte_count > 0x800000) byte_count = 0x800000 - target_addr;
+
+    RT64::RenderTarget* target = nullptr;
+
+    RT64::RenderTargetKey targetKey(target_addr, fb_size.x, target_siz, fbType);
+    auto& sharedTarget = app->sharedQueueResources->renderTargetManager.get(targetKey, true);
+    if (!sharedTarget.isEmpty()) {
+        target = &sharedTarget;
+    } else {
+        auto& stateTarget = app->state->renderTargetManager.get(targetKey, true);
+        if (!stateTarget.isEmpty()) {
+            target = &stateTarget;
+        }
+    }
+
+    if (!target || target->isEmpty()) {
+        if (out_hash) *out_hash = 0;
+        out_pixels.clear();
+        return false;
+    }
+
+    RT64::Framebuffer readbackFb;
+    readbackFb.addressStart = target_addr;
+    readbackFb.width = fb_size.x;
+    readbackFb.height = fb_size.y;
+    readbackFb.siz = target_siz;
+    readbackFb.nativeTarget.resetBufferHistory();
+
+    out_pixels.resize(byte_count);
+
+    {
+        RT64::RenderWorkerExecution execution(app->framebufferGraphicsWorker.get());
+        readbackFb.nativeTarget.copyToNative(app->framebufferGraphicsWorker.get(), target, fb_size.x, 0, fb_size.y, target_siz, target_fmt, 3, 0, app->shaderLibrary.get());
+    }
+
+    readbackFb.copyNativeToRAM(out_pixels.data(), fb_size.x, 0, fb_size.y);
+
+    if (out_hash) {
+        *out_hash = XXH3_64bits(out_pixels.data(), out_pixels.size());
+    }
+    return true;
+}
