diff --git a/recompinput/include/recompinput/device_label.h b/recompinput/include/recompinput/device_label.h
new file mode 100644
index 0000000..35f8d64
--- /dev/null
+++ b/recompinput/include/recompinput/device_label.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <string>
+
+namespace recompinput {
+    // Disconnected: an assigned controller went away; the player stays neutral until
+    // re-assigned. NoController: single-player reads any controller and none is attached.
+    enum class DeviceLabelState { NotAssigned, Keyboard, Controller, Disconnected, NoController };
+
+    // Text shown under a player card. The name comes from SDL; a missing name is
+    // never replaced by a guessed brand. The state is spelled out in words so it
+    // never depends on color alone.
+    inline std::string device_label(DeviceLabelState state, const char* controller_name = nullptr) {
+        switch (state) {
+            case DeviceLabelState::NotAssigned:
+                return "Not assigned";
+            case DeviceLabelState::Keyboard:
+                return "Keyboard";
+            case DeviceLabelState::Controller:
+                return controller_name != nullptr && controller_name[0] != '\0' ? controller_name : "Controller";
+            case DeviceLabelState::Disconnected:
+                return "Disconnected - reconnect, then Re-assign Players";
+            case DeviceLabelState::NoController:
+                return "No controller connected";
+        }
+        return "Not assigned";
+    }
+}
