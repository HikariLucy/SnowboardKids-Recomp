+bool renderer::RT64Context::import_semantic_state(const uint8_t* data, size_t size) {
+    if (!app || !app->state || !app->state->rdp || !data) return false;
+    if (size < sizeof(sbk::quiescence::SemanticStateHeader)) return false;
+
+    sbk::quiescence::SemanticStateHeader header;
+    std::memcpy(&header, data, sizeof(header));
+    if (header.magic != sbk::quiescence::SEMANTIC_STATE_MAGIC || header.version != sbk::quiescence::SEMANTIC_STATE_VERSION) {
+        return false;
+    }
+
+    auto* rdp = app->state->rdp.get();
+    std::memcpy(rdp->TMEM, header.rdp.tmem, 4096);
+    for (int i = 0; i < 8; ++i) {
+        rdp->tiles[i].fmt = header.rdp.tiles[i].fmt;
+        rdp->tiles[i].siz = header.rdp.tiles[i].siz;
+        rdp->tiles[i].line = header.rdp.tiles[i].line;
+        rdp->tiles[i].tmem = header.rdp.tiles[i].tmem;
+        rdp->tiles[i].palette = header.rdp.tiles[i].palette;
+        rdp->tiles[i].cmt = header.rdp.tiles[i].cmt;
+        rdp->tiles[i].cms = header.rdp.tiles[i].cms;
+        rdp->tiles[i].maskt = header.rdp.tiles[i].maskt;
+        rdp->tiles[i].masks = header.rdp.tiles[i].masks;
+        rdp->tiles[i].shiftt = header.rdp.tiles[i].shiftt;
+        rdp->tiles[i].shifts = header.rdp.tiles[i].shifts;
+        rdp->tiles[i].uls = header.rdp.tiles[i].uls;
+        rdp->tiles[i].ult = header.rdp.tiles[i].ult;
+        rdp->tiles[i].lrs = header.rdp.tiles[i].lrs;
+        rdp->tiles[i].lrt = header.rdp.tiles[i].lrt;
+        rdp->tileReplacementHashes[i] = header.rdp.tiles[i].replacement_hash;
+    }
+    rdp->texture.fmt = header.rdp.texture_fmt;
+    rdp->texture.siz = header.rdp.texture_siz;
+    rdp->texture.width = header.rdp.texture_width;
+    rdp->texture.address = header.rdp.texture_address;
+
+    rdp->colorImage.address = header.rdp.color_image_address;
+    rdp->colorImage.fmt = header.rdp.color_image_fmt;
+    rdp->colorImage.siz = header.rdp.color_image_siz;
+    rdp->colorImage.width = header.rdp.color_image_width;
+
+    rdp->depthImage.address = header.rdp.depth_image_address;
+
+    rdp->otherMode.H = header.rdp.other_mode_h;
+    rdp->otherMode.L = header.rdp.other_mode_l;
+
+    rdp->colorCombinerStack[0].L = static_cast<uint32_t>(header.rdp.combiner_cycle1);
+    rdp->colorCombinerStack[0].H = static_cast<uint32_t>(header.rdp.combiner_cycle2);
+
+    std::memcpy(&rdp->envColorStack[0], header.rdp.env_color, sizeof(float) * 4);
+    std::memcpy(&rdp->primColorStack[0], header.rdp.prim_color, sizeof(float) * 4);
+    std::memcpy(&rdp->primLODStack[0], header.rdp.prim_lod, sizeof(float) * 2);
+    std::memcpy(&rdp->primDepthStack[0], header.rdp.prim_depth, sizeof(float) * 2);
+    std::memcpy(&rdp->blendColorStack[0], header.rdp.blend_color, sizeof(float) * 4);
+    std::memcpy(&rdp->fogColorStack[0], header.rdp.fog_color, sizeof(float) * 4);
+    rdp->fillColorStack[0] = header.rdp.fill_color;
+
+    rdp->scissorRectStack[0].ulx = header.rdp.scissor_ulx;
+    rdp->scissorRectStack[0].uly = header.rdp.scissor_uly;
+    rdp->scissorRectStack[0].lrx = header.rdp.scissor_lrx;
+    rdp->scissorRectStack[0].lry = header.rdp.scissor_lry;
+    rdp->scissorModeStack[0] = header.rdp.scissor_mode;
+
+    std::memcpy(rdp->convertK, header.rdp.convert_k, sizeof(int32_t) * 6);
+    std::memcpy(&rdp->keyCenter, header.rdp.key_center, sizeof(float) * 3);
+    std::memcpy(&rdp->keyScale, header.rdp.key_scale, sizeof(float) * 3);
+
+    auto& vi = app->state->lastScreenVI;
+    vi.status.word = header.vi.status;
+    vi.origin = header.vi.origin;
+    vi.width = header.vi.width;
+    vi.intr = header.vi.v_intr;
+    vi.vCurrentLine = header.vi.v_current;
+    vi.burst.word = header.vi.burst;
+    vi.vSync = header.vi.v_sync;
+    vi.hSync.word = header.vi.h_sync;
+    vi.leap.word = header.vi.leap;
+    vi.hRegion.word = header.vi.h_video;
+    vi.vRegion.word = header.vi.v_video;
+    vi.vBurst.word = header.vi.v_burst;
+    vi.xTransform.word = header.vi.x_scale;
+    vi.yTransform.word = header.vi.y_scale;
+
+    size_t offset = sizeof(header);
+    for (uint32_t i = 0; i < header.framebuffer_count; ++i) {
+        if (offset + sizeof(sbk::quiescence::SemanticFramebufferHeader) > size) break;
+        sbk::quiescence::SemanticFramebufferHeader fb_hdr;
+        std::memcpy(&fb_hdr, data + offset, sizeof(fb_hdr));
+        offset += sizeof(fb_hdr);
+
+        if (offset + fb_hdr.pixel_bytes > size) break;
+        const uint8_t* pixels = data + offset;
+        offset += fb_hdr.pixel_bytes;
+
+        auto fbType = (fb_hdr.type == 1) ? RT64::Framebuffer::Type::Color : RT64::Framebuffer::Type::Depth;
+        auto& fb = app->sharedQueueResources->framebufferManager.get(fb_hdr.address, fb_hdr.siz, fb_hdr.width, fb_hdr.height);
+        fb.lastWriteType = fbType;
+        fb.lastWriteFmt = fb_hdr.fmt;
+
+        RT64::RenderTargetKey targetKey(fb_hdr.address, fb_hdr.width, fb_hdr.siz, fbType);
+        auto& target = app->sharedQueueResources->renderTargetManager.get(targetKey, true);
+        if (target.isEmpty()) {
+            hlslpp::float2 resScale = app->sharedQueueResources->resolutionScale;
+            uint32_t targetW = 0, targetH = 0, misalignX = 0;
+            RT64::RenderTarget::computeScaledSize(fb_hdr.width, fb_hdr.height, resScale, targetW, targetH, misalignX);
+            target.resize(app->framebufferGraphicsWorker.get(), targetW, targetH);
+            target.resolutionScale = resScale;
+            target.downsampleMultiplier = app->userConfig.downsampleMultiplier;
+        }
+
+        {
+            RT64::RenderWorkerExecution execution(app->framebufferGraphicsWorker.get());
+            if (fbType == RT64::Framebuffer::Type::Color) {
+                target.clearColorTarget(app->framebufferGraphicsWorker.get());
+            }
+            else {
+                target.clearDepthTarget(app->framebufferGraphicsWorker.get());
+            }
+            RT64::FramebufferChange* change = fb.readChangeFromBytes(app->framebufferGraphicsWorker.get(),
+                app->presentQueue->screenFbChangePool, fbType, fb_hdr.fmt,
+                pixels, 0, fb_hdr.height, app->shaderLibrary.get());
+            if (change != nullptr) {
+                target.copyFromChanges(app->framebufferGraphicsWorker.get(), *change, fb_hdr.width, fb_hdr.height, 0, app->shaderLibrary.get());
+            }
+        }
+
+        if (fb_hdr.address + fb_hdr.pixel_bytes <= 0x800000) {
+            uint64_t ram_h = XXH3_64bits(&app->core.RDRAM[fb_hdr.address], fb_hdr.pixel_bytes);
+            fb.RAMBytes = fb_hdr.pixel_bytes;
+            fb.RAMHash = ram_h;
+            auto& stateFb = app->state->framebufferManager.get(fb_hdr.address, fb_hdr.siz, fb_hdr.width, fb_hdr.height);
+            stateFb.lastWriteType = fbType;
+            stateFb.lastWriteFmt = fb_hdr.fmt;
+            stateFb.RAMBytes = fb_hdr.pixel_bytes;
+            stateFb.RAMHash = ram_h;
+        }
+    }
+
+    uint32_t vi_fb_addr = vi.fbAddress();
+    auto vi_sz = vi.fbSize();
+    uint8_t vi_siz = vi.fbSiz();
+    if (vi_sz.x > 0 && vi_sz.y > 0 && vi_siz >= G_IM_SIZ_16b && vi_fb_addr < 0x800000) {
+        uint32_t vi_bytes = (uint32_t(vi_sz.x * vi_sz.y) << (vi_siz - 1));
+        if (vi_fb_addr + vi_bytes <= 0x800000) {
+            app->state->lastScreenHash = XXH3_64bits(&app->core.RDRAM[vi_fb_addr], vi_bytes);
+        }
+    }
+
+    app->state->viHistory = RT64::VIHistory();
+    app->presentQueue->viHistory = RT64::VIHistory();
+    app->sharedQueueResources->interpolatedFrames[0] = {};
+    app->sharedQueueResources->interpolatedFrames[1] = {};
+    app->sharedQueueResources->interpolatedColorTargets.clear();
+    app->state->lastScreenFactorCounter = 0;
+
+    sbk::quiescence::note("renderer-semantic", "import", size);
+    return true;
+}
+
+bool renderer::RT64Context::present_restored_frame() {
+    if (!app || !app->presentQueue || !app->state) return false;
+    app->state->updateScreen(app->state->lastScreenVI, true);
+    app->presentQueue->waitForIdle();
+    sbk::quiescence::note("renderer-semantic", "present");
+    return true;
+}
+
+bool renderer::RT64Context::capture_framebuffer_hash(uint64_t* out_hash) {
+    if (!app || !app->state || !out_hash) return false;
+    const auto& vi = app->state->lastScreenVI;
+    uint32_t fb_addr = vi.fbAddress();
+    auto fb_size = vi.fbSize();
+    uint8_t fb_siz = vi.fbSiz();
+    if (fb_size.x == 0 || fb_size.y == 0 || fb_siz < G_IM_SIZ_16b || fb_addr >= 0x800000) {
+        *out_hash = 0;
+        return true;
+    }
+    uint32_t byte_count = (uint32_t(fb_size.x * fb_size.y) << (fb_siz - 1));
+    if (fb_addr + byte_count > 0x800000) byte_count = 0x800000 - fb_addr;
+    *out_hash = XXH3_64bits(&app->core.RDRAM[fb_addr], byte_count);
+    return true;
+}
