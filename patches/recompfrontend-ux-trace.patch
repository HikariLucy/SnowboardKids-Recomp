diff --git a/recompinput/include/recompinput/ux_trace.h b/recompinput/include/recompinput/ux_trace.h
new file mode 100644
index 0000000..919fc55
--- /dev/null
+++ b/recompinput/include/recompinput/ux_trace.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace recompinput::ux_trace {
+inline bool enabled() {
+    static const bool active = [] {
+        const char* value = std::getenv("SBK_UX_TRACE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return active;
+}
+
+inline void log(const char* message) {
+    if (!enabled()) return;
+    std::fprintf(stderr, "UX %s\n", message);
+    std::fflush(stderr);
+}
+
+template <typename... Args>
+inline void log(const char* format, Args... args) {
+    if (!enabled()) return;
+    std::fprintf(stderr, "UX ");
+    std::fprintf(stderr, format, args...);
+    std::fprintf(stderr, "\n");
+    std::fflush(stderr);
+}
+}
