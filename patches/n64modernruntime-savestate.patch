+void ultramodern::savestate::import_external_inbox(const std::vector<InboxMessage>& messages) {
+    std::lock_guard lock(external_producer_mutex);
+    QueuedMessage discarded;
+    while (external_messages.try_dequeue(discarded)) {
+        sbk::quiescence::note("external-events", "replaced", discarded.identity);
+    }
+    for (const auto& entry : messages) {
