 }
 
 extern "C" void osStopThread(RDRAM_ARG PTR(OSThread) t_) {
+    // libultra permits stopping either the current thread or another thread
+    // that is runnable/waiting. Snowboard Kids relies on the latter to pause
+    // gAudioThread while mutating shared audio state.
     if (t_ == NULLPTR) {
         t_ = thread_self;
     }
-    // Check if the thread is stopping itself (arg is null or thread_self).
+
+    OSThread* t = TO_PTR(OSThread, t_);
+
+    // Stopping the currently executing thread suspends it until another
+    // osStartThread() schedules it again.
     if (t_ == thread_self) {
+        t->state = OSThreadState::STOPPED;
         ultramodern::run_next_thread_and_wait(PASS_RDRAM1);
+        return;
     }
-    else {
-        assert(false);
+
+    // A different N64 thread cannot be actively executing at the same time
+    // under ultramodern's cooperative scheduler. Runnable and waiting
+    // threads live in a queue; remove them and leave their native host thread
+    // asleep until osStartThread() resumes them.
+    if (t->state == OSThreadState::QUEUED || t->state == OSThreadState::BLOCKED) {
+        if (t->queue != NULLPTR) {
+            ultramodern::thread_queue_remove(PASS_RDRAM t->queue, t_);
+        }
+        t->state = OSThreadState::STOPPED;
     }
 }
 
