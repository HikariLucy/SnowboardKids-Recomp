+bool renderer::RT64Context::get_rdram_framebuffer_hash(bool depth, uint64_t* out_hash) {
+    if (!app || !app->state || !out_hash) return false;
+    const auto& vi = app->state->lastScreenVI;
+    auto fb_size = vi.fbSize();
+    uint8_t fb_siz = vi.fbSiz();
+    if (fb_size.x == 0 || fb_size.y == 0) return false;
+
+    uint32_t addr = 0;
+    uint8_t siz = fb_siz;
+    if (!depth) {
+        addr = vi.fbAddress();
+        if (addr >= 0x800000 || siz < G_IM_SIZ_16b) return false;
+    } else {
+        addr = app->state->rdp ? app->state->rdp->depthImage.address : 0;
+        if (addr == 0 || addr >= 0x800000) return false;
+        siz = G_IM_SIZ_16b;
+    }
+
+    uint32_t byte_count = (uint32_t(fb_size.x * fb_size.y) << (siz - 1));
+    if (addr + byte_count > 0x800000) byte_count = 0x800000 - addr;
+
+    *out_hash = XXH3_64bits(&app->core.RDRAM[addr], byte_count);
+    return true;
+}
