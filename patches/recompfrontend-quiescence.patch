+bool renderer::RT64Context::drain_for_quiescence() {
+    app->workloadQueue->waitForWorkloadId(app->state->workloadId);
+    app->presentQueue->waitForPresentId(app->state->presentId);
+    app->workloadQueue->waitForIdle();
+    app->presentQueue->waitForIdle();
+    app->workloadQueue->setQuiescence(true);
+    quiescent = true;
+    sbk::quiescence::note("renderer-idle", "park-ack");
+    // CPU queue IDs may advance before the final GPU submission finishes.
+    // Idle submissions are now parked; fence waits hold no renderer locks.
+    auto fence_queue = [&](RT64::RenderWorker* worker, const char* participant) {
+        // Plume's Vulkan wait resets a fence. Re-waiting a worker's already
+        // consumed fence (or an unused worker) deadlocks. Submit a fresh empty
+        // command list and private fence after all accepted work instead.
+        auto marker = worker->commandQueue->createCommandList();
+        auto fence = app->device->createCommandFence();
+        marker->begin();
+        marker->end();
+        worker->commandQueue->executeCommandLists(marker.get(), fence.get());
+        worker->commandQueue->waitForCommandFence(fence.get());
+        sbk::quiescence::note(participant, "fence-ack");
+    };
+    fence_queue(app->workloadGraphicsWorker.get(), "gpu-workload");
+    fence_queue(app->presentGraphicsWorker.get(), "gpu-present");
+    fence_queue(app->framebufferGraphicsWorker.get(), "gpu-framebuffer");
+    sbk::quiescence::note("renderer-gpu", "fences-complete");
+    return true;
+}
+
+void renderer::RT64Context::resume_from_quiescence() {
+    if (!quiescent) return;
+    quiescent = false;
+    sbk::quiescence::note("renderer-idle", "resume");
+    app->workloadQueue->setQuiescence(false);
+}
