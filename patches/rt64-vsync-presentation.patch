+    void PresentQueue::threadRecordPresentTiming(std::chrono::steady_clock::time_point blockStart, std::chrono::steady_clock::time_point blockEnd) {
+        PresentTiming &t = presentTiming;
+        const double blockMs = std::chrono::duration<double, std::milli>(blockEnd - blockStart).count();
+        if (t.last != std::chrono::steady_clock::time_point()) {
+            const double intervalMs = std::chrono::duration<double, std::milli>(blockEnd - t.last).count();
+            t.intervalMinMs = (t.count == 0) ? intervalMs : std::min(t.intervalMinMs, intervalMs);
+            t.intervalMaxMs = std::max(t.intervalMaxMs, intervalMs);
+            t.intervalSumMs += intervalMs;
+            t.blockSumMs += blockMs;
+            t.blockMaxMs = std::max(t.blockMaxMs, blockMs);
+            t.count++;
+        }
+
+        t.last = blockEnd;
+
+        constexpr uint32_t SummaryPresents = 600;
+        if (t.count == SummaryPresents) {
+            fprintf(stderr, "RT64 present timing: vsync=%s presents=%u interval_ms mean=%.3f min=%.3f max=%.3f present_block_ms mean=%.3f max=%.3f\n",
+                vsyncActive ? "On" : "Off", t.count, t.intervalSumMs / t.count, t.intervalMinMs, t.intervalMaxMs, t.blockSumMs / t.count, t.blockMaxMs);
+            const auto last = t.last;
+            t = PresentTiming();
+            t.enabled = true;
+            t.last = last;
+        }
+    }
