+    void WorkloadQueue::setQuiescence(bool requested) {
+        std::unique_lock<std::mutex> lock(idleMutex);
+        quiescenceRequested = requested;
+        idleCondition.notify_all();
+        if (requested) {
+            // condition_variable releases idleMutex while waiting for the idle
+            // worker to finish its current GPU operation and acknowledge.
+            idleCondition.wait(lock, [&] { return idleQuiescent || !threadsRunning; });
+        }
+    }
+
     void WorkloadQueue::waitForIdle() {
         std::unique_lock<std::mutex> threadLock(threadMutex);
     }
