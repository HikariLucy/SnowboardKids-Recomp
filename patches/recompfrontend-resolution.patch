diff --git a/recompui/include/recompui/resolution.h b/recompui/include/recompui/resolution.h
new file mode 100644
index 0000000..0414ee3
--- /dev/null
+++ b/recompui/include/recompui/resolution.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include "librecomp/config.hpp"
+#include "ultramodern/config.hpp"
+
+namespace recompui::resolution {
+    using ultramodern::renderer::Resolution;
+
+    struct Preset {
+        Resolution value;
+        const char* key;
+        const char* label;
+        double multiplier; // Zero selects RT64's window-dependent integer scaling.
+    };
+
+    inline constexpr std::array<Preset, 7> presets{{
+        {Resolution::Original, "Original", "Original", 1.0},
+        {Resolution::Original2x, "Original2x", "480p", 2.0},
+        {Resolution::P720, "720p", "720p-class", 3.0},
+        {Resolution::P1080, "1080p", "1080p-class", 4.5},
+        {Resolution::P1440, "1440p", "1440p-class", 6.0},
+        {Resolution::P2160, "2160p", "2160p/4K-class", 9.0},
+        {Resolution::Auto, "Auto", "Auto", 0.0},
+    }};
+
+    inline std::vector<recomp::config::ConfigOptionEnumOption> options() {
+        std::vector<recomp::config::ConfigOptionEnumOption> result;
+        for (const auto& preset : presets) {
+            result.emplace_back(preset.value, preset.key, preset.label);
+        }
+        return result;
+    }
+
+    struct Scale {
+        double multiplier;
+        int downsample;
+    };
+
+    inline Scale scale(Resolution value, int downsample) {
+        // Preserve supersampling for old configs. Explicit HD presets always
+        // use their stated internal scale, even if a saved ds_option is active.
+        const int ds = (value == Resolution::Original || value == Resolution::Original2x)
+            ? std::max(downsample, 1) : 1;
+        for (const auto& preset : presets) {
+            if (preset.value == value) {
+                return {preset.multiplier * ds, ds};
+            }
+        }
+        return {0.0, 1}; // Keep the renderer's existing unknown-value Auto fallback.
+    }
+}
