+std::vector<ultramodern::savestate::InboxMessage> ultramodern::savestate::export_external_inbox() {
+    std::lock_guard lock(external_producer_mutex);
+    // Every admission uses the single producer token, so draining yields the
+    // exact delivery order. Reinsert unchanged (same identities).
+    std::vector<QueuedMessage> drained;
+    QueuedMessage message;
+    while (external_messages.try_dequeue(message)) drained.push_back(message);
+    std::vector<InboxMessage> result;
+    result.reserve(drained.size());
+    for (const auto& entry : drained) {
+        external_messages.enqueue(external_producer, entry);
+        result.push_back({entry.mq, static_cast<uint32_t>(entry.mesg), entry.jam, entry.requeue_if_blocked});
+    }
