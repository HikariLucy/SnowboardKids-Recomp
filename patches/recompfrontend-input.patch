diff --git a/recompinput/include/recompinput/deadzone.h b/recompinput/include/recompinput/deadzone.h
new file mode 100644
index 0000000..61406ce
--- /dev/null
+++ b/recompinput/include/recompinput/deadzone.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace recompinput {
+    // Radial deadzone for a stick in [-1, 1] per axis. Inside the deadzone the stick is neutral;
+    // outside it the magnitude is rescaled from [deadzone, 1] to [0, 1] and the direction is kept,
+    // so diagonals stay diagonal and partial deflection stays proportional. The result never
+    // leaves the unit circle, even for a square-gated stick reporting (1, 1).
+    inline void radial_deadzone(float x_in, float y_in, float deadzone, float* x_out, float* y_out) {
+        deadzone = std::clamp(deadzone, 0.0f, 0.95f);
+        const float magnitude = std::sqrt(x_in * x_in + y_in * y_in);
+        if (!(magnitude > deadzone)) { // also rejects NaN
+            *x_out = 0.0f;
+            *y_out = 0.0f;
+            return;
+        }
+
+        const float scaled = (std::min(magnitude, 1.0f) - deadzone) / (1.0f - deadzone);
+        *x_out = x_in * (scaled / magnitude);
+        *y_out = y_in * (scaled / magnitude);
+    }
+}
